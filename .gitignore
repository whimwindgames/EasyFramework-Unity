# ============================================
# Unity 项目 .gitignore (Unity 6 / 6000.x)
# ============================================

# Unity 生成的缓存与临时目录(切勿提交,Library 可达数 GB)
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/

# Recordings(录制)
[Rr]ecordings/

# Asset meta 文件:仅当对应资源本身被忽略时才忽略
!/[Aa]ssets/**/*.meta

# Rider 插件自动生成
[Aa]ssets/Plugins/Editor/JetBrains*

# IDE / 编辑器缓存
.vs/
.vsconfig
.idea/
.gradle/

# 自动生成的工程文件(由 Unity 重新生成,不入库)
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity 崩溃报告
sysinfo.txt

# 构建产物
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# Addressables 打包产物
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# 自动生成的 Android StreamingAssets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# macOS / 系统垃圾文件
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
